# VehicleGPT Configuration

# Environment
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Edge Hardware Profile (constrained, development, vehicle_hpc)
HARDWARE_PROFILE=development

# Database Settings
DATABASE_PATH=data/vehiclegpt.db
DB_TIMEOUT_SECONDS=15
DB_ENABLE_WAL=true

# Retention Configuration (in days/weeks)
RETENTION_HOT_HOURS=72
RETENTION_WARM_DAYS=7
RETENTION_COLD_WEEKS=12
RETENTION_DTC_MONTHS=6

# Simulation Settings
SIMULATION_VEHICLE_ID=VIN-TATA-EV-2026-X01
SIMULATION_SEED=42
SIMULATION_AUTO_START=true
SIMULATION_INTERVAL_MS=1000

# Local SLM Settings (llama.cpp)
# To use an on-device GGUF model, place it in models/ and specify filename here:
# e.g., models/Llama-3.2-1B-Instruct-Q4_K_M.gguf or models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
LLM_MODEL_PATH=models/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLM_CONTEXT_SIZE=2048
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_ENABLE_FALLBACK=true

# Safety Controls
READ_ONLY_VEHICLE_BUS=true
BLOCK_ACTUATOR_COMMANDS=true
ALLOW_CLOUD_APIS=false
